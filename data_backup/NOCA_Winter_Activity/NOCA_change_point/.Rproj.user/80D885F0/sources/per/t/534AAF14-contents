# Create a function to convert weeks to bi-weekly periods
week_to_biweekly <- function(week) {
  case_when(
    week >= 1 & week <= 2   ~ "Weeks 1-2",
    week >= 3 & week <= 4   ~ "Weeks 3-4", 
    week >= 5 & week <= 6   ~ "Weeks 5-6",
    week >= 7 & week <= 8   ~ "Weeks 7-8",
    week >= 9 & week <= 10  ~ "Weeks 9-10",
    week >= 11 & week <= 12 ~ "Weeks 11-12",
    week >= 13 & week <= 14 ~ "Weeks 13-14",
    week >= 15 & week <= 16 ~ "Weeks 15-16",
    week >= 17 & week <= 18 ~ "Weeks 17-18",
    week >= 19 & week <= 20 ~ "Weeks 19-20",
    week >= 21 & week <= 22 ~ "Weeks 21-22",
    week >= 23 & week <= 24 ~ "Weeks 23-24",
    week >= 25 & week <= 26 ~ "Weeks 25-26",
    week >= 27 & week <= 28 ~ "Weeks 27-28",
    week >= 29 & week <= 30 ~ "Weeks 29-30",
    week >= 31 & week <= 32 ~ "Weeks 31-32",
    week >= 33 & week <= 34 ~ "Weeks 33-34",
    week >= 35 & week <= 36 ~ "Weeks 35-36",
    week >= 37 & week <= 38 ~ "Weeks 37-38",
    week >= 39 & week <= 40 ~ "Weeks 39-40",
    week >= 41 & week <= 42 ~ "Weeks 41-42",
    week >= 43 & week <= 44 ~ "Weeks 43-44",
    week >= 45 & week <= 46 ~ "Weeks 45-46",
    week >= 47 & week <= 48 ~ "Weeks 47-48",
    week >= 49 & week <= 50 ~ "Weeks 49-50",
    week >= 51 & week <= 52 ~ "Weeks 51-52",
    week == 53 ~ "Week 53",
    TRUE ~ NA_character_
  )
}

# Add bi-weekly period and numeric period for ordering
noca_mbo <- noca_mbo %>%
  mutate(
    BiWeekly = week_to_biweekly(week),
    BiWeekly_num = case_when(
      week >= 1 & week <= 2   ~ 1,
      week >= 3 & week <= 4   ~ 2,
      week >= 5 & week <= 6   ~ 3,
      week >= 7 & week <= 8   ~ 4,
      week >= 9 & week <= 10  ~ 5,
      week >= 11 & week <= 12 ~ 6,
      week >= 13 & week <= 14 ~ 7,
      week >= 15 & week <= 16 ~ 8,
      week >= 17 & week <= 18 ~ 9,
      week >= 19 & week <= 20 ~ 10,
      week >= 21 & week <= 22 ~ 11,
      week >= 23 & week <= 24 ~ 12,
      week >= 25 & week <= 26 ~ 13,
      week >= 27 & week <= 28 ~ 14,
      week >= 29 & week <= 30 ~ 15,
      week >= 31 & week <= 32 ~ 16,
      week >= 33 & week <= 34 ~ 17,
      week >= 35 & week <= 36 ~ 18,
      week >= 37 & week <= 38 ~ 19,
      week >= 39 & week <= 40 ~ 20,
      week >= 41 & week <= 42 ~ 21,
      week >= 43 & week <= 44 ~ 22,
      week >= 45 & week <= 46 ~ 23,
      week >= 47 & week <= 48 ~ 24,
      week >= 49 & week <= 50 ~ 25,
      week >= 51 & week <= 52 ~ 26,
      week == 53 ~ 27,
      TRUE ~ NA_real_
    )
  )

# Get total counts by week for error bar calculations (combining all birds)
weekly_total_counts <- noca_mbo %>%
  group_by(week, BiWeekly, BiWeekly_num) %>%
  summarise(Total_Count = n(), .groups = 'drop')

# Calculate mean and SE for total counts (for error bars)
biweekly_total_stats <- weekly_total_counts %>%
  group_by(BiWeekly, BiWeekly_num) %>%
  summarise(
    mean_total = mean(Total_Count, na.rm = TRUE),
    se_total = sd(Total_Count, na.rm = TRUE) / sqrt(n()),
    n_weeks = n(),
    .groups = 'drop'
  ) %>%
  mutate(se_total = ifelse(is.na(se_total) | n_weeks == 1, 0, se_total))

# Get counts by week and age category for stacking
weekly_age_counts <- noca_mbo %>%
  group_by(week, BiWeekly, BiWeekly_num, Age_Category) %>%
  summarise(Count = n(), .groups = 'drop')

# Calculate mean counts by age category for stacked bars
biweekly_age_stats <- weekly_age_counts %>%
  group_by(BiWeekly, BiWeekly_num, Age_Category) %>%
  summarise(
    mean_count = mean(Count, na.rm = TRUE),
    .groups = 'drop'
  )

# Merge the two datasets
plot_data <- biweekly_age_stats %>%
  left_join(biweekly_total_stats, by = c("BiWeekly", "BiWeekly_num"))

# Create ordered factors
plot_data <- plot_data %>%
  arrange(BiWeekly_num) %>%
  mutate(
    BiWeekly = factor(BiWeekly, levels = unique(BiWeekly)),
    Age_Category = factor(Age_Category, levels = c("Adult", "Juvenile", "Unknown"))
  )

# Create the plot
spring_label <- "Spring migration monitoring"
fall_label   <- "Fall migration monitoring"

ggplot(plot_data, aes(x = BiWeekly, y = mean_count, fill = Age_Category)) +
  geom_col(position = "stack", alpha = 0.8) +
  geom_errorbar(aes(ymin = mean_total - se_total, ymax = mean_total + se_total),
                width = 0.4, linewidth = 0.7, color = "black") +
  
  # Spring and fall boxes
  annotate("rect", xmin = 4.5, xmax = 11.5, ymin = -Inf, ymax = Inf,
           color = "black", linetype = "dashed", fill = "grey40", alpha = 0.1) +
  annotate("text", x = 8, y = max(plot_data$mean_total + plot_data$se_total, na.rm = TRUE) * 0.95,
           label = spring_label, size = 4, hjust = 0.5, vjust = 1) +
  
  annotate("rect", xmin = 13.5, xmax = 22.5, ymin = -Inf, ymax = Inf,
           color = "black", linetype = "dashed", fill = "grey40", alpha = 0.1) +
  annotate("text", x = 18, y = max(plot_data$mean_total + plot_data$se_total, na.rm = TRUE) * 0.95,
           label = fall_label, size = 4, hjust = 0.5, vjust = 1) +
  
  # Expand y-axis for labels
  expand_limits(y = max(plot_data$mean_total + plot_data$se_total, na.rm = TRUE) * 1.05) +
  
  scale_fill_manual(
    values = c(
      "Adult" = "#44AA99",        # Dark green for adults
      "Juvenile" = "#CC6677",     # Orange for juveniles  
      "Unknown" = "#D3D3D3"       # Light gray for unknown
    ),
    name = "Age Category"
  ) +
  labs(x = "Bi-weekly Period", y = "Mean Number of Cardinals") +
  theme_minimal() +
  theme(
    axis.text = element_text(size = 12),
    axis.title = element_text(size = 14),
    legend.text = element_text(size = 12),
    legend.title = element_text(size = 13),
    axis.text.x = element_text(angle = 45, hjust = 1, size = 10)
  )

