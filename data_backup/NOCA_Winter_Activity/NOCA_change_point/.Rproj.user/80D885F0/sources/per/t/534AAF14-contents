# Christmas Bird Count.


df <- read.csv("00_raw_data/Final_Cleaned_XMAS.csv")

# Remove rows with missing or zero party hours to avoid division by zero
df <- df %>%
  filter(!is.na(NumberByPartyHours) & NumberByPartyHours > 0)

# Keep only data from NY, QC, VT, NH and ME.
df <- df %>% 
  filter(Province_State %in% c( "NY", "QC", "VT", "NH", "ME"))

coords <- data.frame(
  Province_State = c("ME", "NH", "VT", "NY", "QC"),
  lat = c(45.25, 43.8, 44.0, 43.0, 45.5),
  lon = c(-69.0, -71.6, -72.7, -75.0, -73.6)
)

df <- df %>%
  left_join(coords, by = "Province_State")

df <- df %>%
  mutate(Decade = floor(year / 10) * 10)

# Trying something more visual.
# Get map data for US states and Canada
us_states <- map_data("state")
canada <- map_data("world", region = "canada")

ggplot(df, aes(x = lon, y = lat, size = NumberByPartyHours, color = Province_State)) +
  geom_polygon(data = us_states, aes(x = long, y = lat, group = group),
               fill = NA, color = "gray70", linewidth = 0.5, inherit.aes = FALSE) +
  geom_polygon(data = canada, aes(x = long, y = lat, group = group),
